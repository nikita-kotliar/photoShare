generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

// Досягнення (TASK-070): умови отримання в achievementsService
enum AchievementCode {
  FIRST_PHOTO
  TEN_PHOTOS
  COMMENTATOR
  CRITIC
  FAVORITE
}

// Про що сповіщення (TASK-068): коментар і оцінка твоєї світлини, нове досягнення,
// призначення модератором
enum NotificationType {
  COMMENT
  RATING
  ACHIEVEMENT
  MODERATOR
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  name         String
  // NULL лише для акаунтів, створених через Google (TASK-066). CHECK у міграції
  // users_login_method_check: має бути пароль або google_id
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  role         Role     @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  avatarUrl    String?  @map("avatar_url")
  bio          String?  @db.VarChar(300)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  photos              Photo[]
  comments            Comment[]
  ratings             Rating[]
  // Сповіщення, які отримав користувач, і ті, причиною яких він став
  notifications       Notification[]    @relation("NotificationRecipient")
  notificationsCaused Notification[]    @relation("NotificationActor")
  achievements        UserAchievement[]
  passwordResets      PasswordReset[]

  @@index([role])
  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("users")
}

model Photo {
  id            Int      @id @default(autoincrement())
  slug          String   @unique @db.VarChar(12)
  url           String
  publicId      String   @unique @map("public_id")
  description   String   @db.VarChar(1000)
  colors        String[] @default([])
  colorFamilies String[] @default([]) @map("color_families")
  authorId      Int      @map("author_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  author           User              @relation(fields: [authorId], references: [id])
  comments         Comment[]
  ratings          Rating[]
  tags             PhotoTag[]
  transformedLinks TransformedLink[]
  notifications    Notification[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([colorFamilies], type: Gin)
  @@map("photos")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")

  photos PhotoTag[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("tags")
}

model PhotoTag {
  photoId Int @map("photo_id")
  tagId   Int @map("tag_id")

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
  @@index([tagId, photoId])
  @@map("photo_tags")
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String   @db.VarChar(1000)
  photoId   Int      @map("photo_id")
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  photo  Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([photoId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
  @@map("comments")
}

model TransformedLink {
  id              Int      @id @default(autoincrement())
  photoId         Int      @map("photo_id")
  url             String
  qrCode          String   @map("qr_code")
  transformations Json
  createdAt       DateTime @default(now()) @map("created_at")

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@map("transformed_links")
}

model Rating {
  id        Int      @id @default(autoincrement())
  photoId   Int      @map("photo_id")
  userId    Int      @map("user_id")
  value     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([photoId, userId])
  @@index([userId])
  @@index([photoId, value])
  @@map("ratings")
}

// Сповіщення (TASK-068). actor - хто зробив дію (NULL для системних, наприклад досягнення),
// photo - про яку світлину. data - деталі для тексту: оцінка, код досягнення
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  actorId   Int?             @map("actor_id")
  photoId   Int?             @map("photo_id")
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  photo Photo? @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@index([actorId])
  @@index([photoId])
  @@map("notifications")
}

// Отримані досягнення (TASK-070). UQ (user_id, code): одне досягнення не дається двічі
model UserAchievement {
  id        Int             @id @default(autoincrement())
  userId    Int             @map("user_id")
  code      AchievementCode
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@map("user_achievements")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model TokenBlacklist {
  jti       String   @id @db.VarChar(36)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("token_blacklist")
}
